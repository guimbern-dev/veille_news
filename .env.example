# Copier ce fichier vers .env (jamais versionné) et remplir les valeurs.
# Clé de l'API Claude : https://platform.claude.com/
ANTHROPIC_API_KEY=
# Clé gratuite de FRED (Réserve fédérale de Saint-Louis) : https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Clé gratuite de Twelve Data, pour le FNB d'actions canadiennes EWC : https://twelvedata.com/
TWELVEDATA_API_KEY=

# Clé gratuite d'Alpha Vantage, pour les FNB cotés à Toronto (XEQT) : https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
